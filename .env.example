# Supabase (get from project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth is configured in Supabase Dashboard (Authentication > Providers)

# Optional: restrict sign-in to these emails (comma-separated). If unset, any Google user can sign in.
# ALLOWED_EMAILS=one@example.com,two@example.com
