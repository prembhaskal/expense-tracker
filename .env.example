# Supabase (get from project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth is configured in Supabase Dashboard (Authentication > Providers)

# Required: comma-separated list of Google emails that can sign in. If unset, no one can sign in.
ALLOWED_EMAILS=one@example.com,two@example.com
